{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bounded-loops-hook verify claude-code",
            "timeout": 130
          },
          {
            "type": "command",
            "command": "bounded-loops-hook graph-run-stop claude-code",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bounded-loops-hook pretooluse-loop-package claude-code",
            "timeout": 10
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ]
  }
}
