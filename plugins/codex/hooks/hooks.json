{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bounded-loops-hook verify codex",
            "timeout": 130
          },
          {
            "type": "command",
            "command": "bounded-loops-hook graph-run-stop codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bounded-loops-hook pretooluse-loop-package codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
