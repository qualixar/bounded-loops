{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bounded-loops.dev/schemas/v1/authoring-graph.schema.json",
  "title": "AuthoringGraphSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "graph_id", "version", "nodes", "edges", "connection_slots", "policies"],
  "properties": {
    "api_version": {"const": "bounded-loops.dev/graph/v1"},
    "graph_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "connection_slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}},
    "policies": {"$ref": "#/$defs/policies"},
    "presentation": {"type": "object"}
  },
  "$defs": {
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "max_wallclock_s"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_wallclock_s": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_tokens": {"type": ["integer", "null"], "minimum": 1},
        "max_cost_microunits": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "baseNode": {
      "type": "object",
      "required": ["id", "kind", "inputs", "outputs", "budget", "effects", "isolation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
        "kind": {"type": "string"},
        "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
        "outputs": {"type": "object", "additionalProperties": {"type": "string"}},
        "budget": {"$ref": "#/$defs/budget"},
        "effects": {"type": "array", "uniqueItems": true, "items": {"enum": ["read_only", "workspace_write", "external_write", "financial", "irreversible"]}},
        "isolation": {"enum": ["workspace_only", "process_restricted", "container_restricted", "customer_managed_worker"]},
        "connection_slot": {"type": ["string", "null"]},
        "on_failure": {"enum": ["fail_graph", "continue", "repair", "await_human"]}
      }
    },
    "node": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "required": ["loop_package"], "properties": {"kind": {"const": "loop"}, "loop_package": {"$ref": "#/$defs/digestRef"}}}]},
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "required": ["tool_ref"], "properties": {"kind": {"const": "tool"}, "tool_ref": {"type": "string"}}}]},
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "required": ["routes"], "properties": {"kind": {"const": "router"}, "routes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}, "default_route": {"type": ["string", "null"]}}}]},
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "required": ["mode"], "properties": {"kind": {"const": "join"}, "mode": {"enum": ["all_selected", "all_successful", "any_successful"]}}}]},
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "required": ["required_role"], "properties": {"kind": {"const": "approval"}, "required_role": {"type": "string"}}}]},
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "required": ["audit_profile"], "properties": {"kind": {"const": "audit"}, "audit_profile": {"type": "string"}}}]},
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "required": ["source_policy"], "properties": {"kind": {"const": "research_source"}, "source_policy": {"type": "string"}}}]},
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "properties": {"kind": {"const": "research_claim"}}}]},
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "required": ["graph_package"], "properties": {"kind": {"const": "subgraph"}, "graph_package": {"$ref": "#/$defs/digestRef"}}}]},
        {"allOf": [{"$ref": "#/$defs/baseNode"}, {"type": "object", "required": ["publication_policy"], "properties": {"kind": {"const": "publish"}, "publication_policy": {"type": "string"}}}]}
      ],
      "unevaluatedProperties": false
    },
    "digestRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from_node", "from_port", "to_node", "to_port"],
      "properties": {"from_node": {"type": "string"}, "from_port": {"type": "string"}, "to_node": {"type": "string"}, "to_port": {"type": "string"}, "when": {"type": ["string", "null"]}}
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "requires", "data_class_max"],
      "properties": {"id": {"type": "string"}, "requires": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "data_class_max": {"enum": ["public", "internal", "confidential", "restricted"]}, "preferred_modalities": {"type": "array", "items": {"type": "string"}}}
    },
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["data_class", "fail_mode"],
      "properties": {"data_class": {"enum": ["public", "internal", "confidential", "restricted"]}, "fail_mode": {"enum": ["fail_closed", "continue_declared"]}, "required_audit_profile": {"type": ["string", "null"]}}
    }
  }
}
