{
  "$defs": {
    "baseNode": {
      "properties": {
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "connection_slot": {
          "type": [
            "string",
            "null"
          ]
        },
        "effects": {
          "items": {
            "enum": [
              "read_only",
              "workspace_write",
              "external_write",
              "financial",
              "irreversible"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "isolation": {
          "description": "Isolation tier. Every value here is schema-valid, but a tier listed in x-never-available can never be enforced on any platform, so a graph using it fails closed at preflight. Authoring tools should not offer those tiers as choices.",
          "enum": [
            "workspace_only",
            "process_restricted",
            "container_restricted",
            "customer_managed_worker"
          ],
          "x-never-available": [
            "customer_managed_worker"
          ]
        },
        "kind": {
          "type": "string"
        },
        "on_failure": {
          "description": "Failure policy for this node. Every value here is schema-valid, but a value listed in x-unimplemented is REFUSED by the compiler (error code on_failure_unimplemented) because the runtime routes every failure to fail_graph and accepting it would silently discard the declared policy. Authoring tools should not offer those values as choices.",
          "x-unimplemented": [
            "await_human",
            "continue"
          ],
          "oneOf": [
            {
              "enum": [
                "fail_graph",
                "continue",
                "repair",
                "await_human"
              ]
            },
            {
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "repair"
                },
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "target"
              ],
              "type": "object"
            }
          ]
        },
        "outputs": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "inputs",
        "outputs",
        "budget",
        "effects",
        "isolation"
      ],
      "type": "object"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "max_cost_microunits": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tokens": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_wallclock_s": {
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_attempts",
        "max_wallclock_s"
      ],
      "type": "object"
    },
    "digestRef": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "edge": {
      "additionalProperties": false,
      "properties": {
        "from_node": {
          "type": "string"
        },
        "from_port": {
          "type": "string"
        },
        "to_node": {
          "type": "string"
        },
        "to_port": {
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from_node",
        "from_port",
        "to_node",
        "to_port"
      ],
      "type": "object"
    },
    "node": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "kind": {
                  "const": "loop"
                },
                "loop_package": {
                  "$ref": "#/$defs/digestRef"
                }
              },
              "required": [
                "loop_package"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "kind": {
                  "const": "tool"
                },
                "tool_ref": {
                  "type": "string"
                }
              },
              "required": [
                "tool_ref"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "default_route": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "const": "router"
                },
                "routes": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "minProperties": 1,
                  "type": "object"
                }
              },
              "required": [
                "routes"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "kind": {
                  "const": "join"
                },
                "mode": {
                  "enum": [
                    "all_selected",
                    "all_successful",
                    "any_successful"
                  ]
                }
              },
              "required": [
                "mode"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "kind": {
                  "const": "approval"
                },
                "required_role": {
                  "type": "string"
                }
              },
              "required": [
                "required_role"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "audit_profile": {
                  "type": "string"
                },
                "kind": {
                  "const": "audit"
                }
              },
              "required": [
                "audit_profile"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "kind": {
                  "const": "research_source"
                },
                "source_policy": {
                  "type": "string"
                }
              },
              "required": [
                "source_policy"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "kind": {
                  "const": "research_claim"
                }
              },
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "graph_package": {
                  "$ref": "#/$defs/digestRef"
                },
                "kind": {
                  "const": "subgraph"
                }
              },
              "required": [
                "graph_package"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/baseNode"
            },
            {
              "properties": {
                "kind": {
                  "const": "publish"
                },
                "publication_policy": {
                  "type": "string"
                }
              },
              "required": [
                "publication_policy"
              ],
              "type": "object"
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "policies": {
      "additionalProperties": false,
      "properties": {
        "data_class": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "fail_mode": {
          "enum": [
            "fail_closed",
            "continue_declared"
          ]
        },
        "repair_budget": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "required_audit_profile": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "data_class",
        "fail_mode"
      ],
      "type": "object"
    },
    "slot": {
      "additionalProperties": false,
      "properties": {
        "data_class_max": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "id": {
          "type": "string"
        },
        "preferred_modalities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requires": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "requires",
        "data_class_max"
      ],
      "type": "object"
    }
  },
  "$id": "https://bounded-loops.dev/schemas/v1/authoring-graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "bounded-loops.dev/graph/v1"
    },
    "connection_slots": {
      "items": {
        "$ref": "#/$defs/slot"
      },
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/edge"
      },
      "type": "array"
    },
    "graph_id": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1,
      "type": "array"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "presentation": {
      "type": "object"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "graph_id",
    "version",
    "nodes",
    "edges",
    "connection_slots",
    "policies"
  ],
  "title": "AuthoringGraphSpec",
  "type": "object"
}
